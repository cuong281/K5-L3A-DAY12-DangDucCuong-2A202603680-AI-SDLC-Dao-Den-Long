{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — 3D lantern-lighting game (Day 12 AI SDLC lab)",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "proof": "node tools/proof.js",
    "headless": "node headless.js",
    "fps-check": "node tools/fps-check.js",
    "bench": "node tools/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc --lite-mode tools/soak.js --seed 7 --nights 10 --out soak.json",
    "start": "node play.js"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "puppeteer-core": "22.15.0",
    "vite": "5.4.10"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
